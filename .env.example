# ==============================================================================
# Cold Outreach Agent Configuration
# Copy this file to .env and populate with your actual API keys and preferences.
# NEVER commit your .env file or credentials to version control.
# ==============================================================================

# Gemini / Google Generative AI API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
MODEL_NAME=models/gemini-2.5-flash

# Tavily Search API (used for web search and company/job discovery)
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# Hunter.io API (used for email discovery and domain search)
HUNTER_API_KEY=your_hunter_api_key_here
# Optional legacy key alias for Hunter:
HUNTER_API=

# LangSmith Tracing & Observability (Optional)
LANGSMITH_TRACING_V2=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=cold-outreach-agent

# Operational Mode
# Set to 'true' to simulate email sending without actually transmitting via Gmail
DRY_RUN=true

# Database URI (Optional / Future Persistence)
DB_URI=

