# Provider credentials are not needed when MOCK_MODE=true.
GEMINI_API_KEY=replace-with-your-gemini-api-key
# Defaults to the model configured in config.py; verify model access with your account.
MODEL_NAME=models/gemini-3.1-flash-lite
TAVILY_API_KEY=replace-with-your-tavily-api-key
HUNTER_API_KEY=replace-with-your-hunter-api-key

# MOCK_MODE uses local deterministic fixtures and never calls external providers.
MOCK_MODE=false
MOCK_SCENARIO=good
# DRY_RUN stops Gmail delivery while allowing real research/drafting when MOCK_MODE=false.
DRY_RUN=true

# Persistence. SQLite is local by default; PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost:5432/cold_outreach
DATABASE_URL=
# Fixed local UI identity is available only with SQLite in development/test; keep disabled otherwise.
APP_ENV=development
WEBAPP_TEST_AUTH=false
# Durable worker broker; Redis/Celery results are not the application status source of truth.
REDIS_URL=redis://localhost:6379/0
# Batch provider/cost bound; each item is independently persisted and retryable.
MAX_BATCH_ITEMS=25
MAX_DRAFT_GENERATIONS=3
# Required by the worker. Generate a private 32-byte key and keep it out of source control.
LANGGRAPH_AES_KEY=
# For local PostgreSQL, put this in the ignored .env after replacing USER and PASSWORD:
# DATABASE_URL=postgresql+psycopg://DB_USER:DB_PASSWORD@localhost:5432/cold_outreach
OUTREACH_OWNER_ID=local
DUPLICATE_COOLDOWN_DAYS=30
RESEARCH_CACHE_TTL_DAYS=30
VERIFICATION_FRESHNESS_DAYS=30
MAX_CONTACTS_PER_COMPANY=5
MAX_EMAIL_VERIFICATIONS=3
MAX_EXTERNAL_CALLS_PER_RUN=20
ALLOW_UNVERIFIED_EMAILS=false
